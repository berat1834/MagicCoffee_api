# Odemeler dogrudan Castles bulutuna (CasPro) gider; POS seri numarasi panelden kiosk profiline atanir.
CASPRO_API_URL=https://external-system-api.tur.castlestech.cloud:6443
# Istege bagli; doluysa X-API-Key basligi eklenir.
