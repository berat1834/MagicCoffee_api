# Transaction/Sale icin HTTP bekleme suresi ve sonuc kurtarma ust siniri (saniye).
CASPRO_TRANSACTION_TIMEOUT_SECONDS=150
CASPRO_RESULT_TIMEOUT_SECONDS=180
GOOGLE_TRANSLATE_API_KEY=
